{
  "name": "wsc-website",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/check-protected-landing-pages.mjs && tsx scripts/seo-audit/generate-public-seo-files.ts && vite build && tsx scripts/seo-audit/generate-static-route-html.ts && node scripts/seo-audit/defer-built-css.mjs && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "landing-pages:check": "node scripts/check-protected-landing-pages.mjs",
    "test": "node scripts/check-protected-landing-pages.mjs && node --import tsx --test scripts/*.test.mjs scripts/*.test.ts",
    "test:coverage": "node --import tsx --experimental-test-coverage --test scripts/*.test.mjs scripts/*.test.ts",
    "test:e2e": "playwright test",
    "content:test": "node --test scripts/content-regression.test.mjs",
    "constant-contact:check": "node scripts/check-constant-contact-setup.mjs",
    "postmark:check": "node scripts/check-postmark-setup.mjs",
    "postmark:smoke-forms": "tsx scripts/smoke-test-form-delivery.mjs",
    "forms:storage-check": "node scripts/check-form-storage.mjs",
    "vercel:bundle-check": "node scripts/check-vercel-bundle.mjs",
    "assets:check": "tsx scripts/asset-audit.ts --check --require-build",
    "assets:audit": "tsx scripts/asset-audit.ts --report=output/asset-audit.json",
    "verify": "pnpm test && pnpm check && pnpm build && pnpm assets:check",
    "seo:test-deployed": "node scripts/seo-audit/test-deployed-redirects.mjs",
    "seo:audit-public": "node scripts/seo-audit/audit-public-seo-files.mjs",
    "seo:prelaunch-report": "node scripts/seo-audit/generate-prelaunch-report.mjs",
    "scrape:live": "node scripts/scrape-wsc-live.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "express": "^4.22.3",
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.453.0",
    "postmark": "^4.0.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "wouter": "^3.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/compression": "^1.8.1",
    "@types/express": "4.17.25",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.29",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "vite": "^8.0.16"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "pnpm": {
    "patchedDependencies": {
      "wouter@3.7.1": "patches/wouter@3.7.1.patch"
    },
    "overrides": {
      "path-to-regexp": "0.1.13",
      "qs": "6.16.0"
    }
  }
}
